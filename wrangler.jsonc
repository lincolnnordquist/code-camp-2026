{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-camp-2026",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    // Unknown paths such as /e/:eventSlug fall back to index.html so React handles the route.
    "not_found_handling": "single-page-application"
  }
}
