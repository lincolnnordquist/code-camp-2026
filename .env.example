# Two groups of values live in two different files. Never commit either file.

# ─── Browser: copy to .env.local ──────────────────────────────────────
# VITE_ values are bundled into the public app. Only public values go here.

# REQUIRED. Local value printed by `supabase start`; hosted value in the
# Supabase dashboard under Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# REQUIRED. The public (anon / publishable) key from the same place.
VITE_SUPABASE_ANON_KEY=

# ─── Edge Functions: copy to supabase/functions/.env ──────────────────
# Server-side secrets. For the hosted project, set each one with
# `supabase secrets set NAME=value`. Never prefix these with VITE_.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge
# Functions automatically and are not set here.

# REQUIRED. Where Square sends the attendee back after checkout.
# TODO: replace with the live site address once it is deployed.
APP_URL=http://localhost:5173

# REQUIRED for prepaid checkout.
SQUARE_ENVIRONMENT=sandbox

# REQUIRED for prepaid checkout. One access token per seeded Square
# sandbox seller, from the Square Developer Dashboard > Sandbox test
# accounts. provider_connections stores the variable name, not the token.
# TODO: rename to match the seeded vendors.
SQUARE_ACCESS_TOKEN_VENDOR_A=
# OPTIONAL. Second sandbox seller (SPEC.md, FR-31).
SQUARE_ACCESS_TOKEN_VENDOR_B=

# REQUIRED for prepaid checkout. Signature key of the Square webhook
# subscription, from the Square Developer Dashboard > Webhooks. The
# subscription listens for payment and refund events.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# REQUIRED for confirmation email. From the Resend dashboard > API Keys.
RESEND_API_KEY=

# REQUIRED for confirmation email. The address must be on a registered
# domain whose DNS records are verified in Resend. The domain needs no
# website and does not have to match the product's final name.
# TODO: replace with the team's domain.
EMAIL_FROM="Event Orders <orders@example.com>"
